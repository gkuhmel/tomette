// Déploiement Cloudflare : le jeu (fichiers statiques de dist/) et un petit Worker
// pour le duel en ligne (/api/room/…, une salle = un Durable Object ; /api/lobby, la file
// du « joueur au hasard »).
// Cloudflare lance `npm run build` puis `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomettes",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Seules les routes /api/ passent par le Worker ; le reste est servi directement.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  // Au plus 30 connexions (salle ou file) par minute et par adresse IP.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ]
}
